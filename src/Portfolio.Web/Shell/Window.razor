@inject DesktopService Desk

<section class="win accent-@State.App.Accent @(IsActive ? "is-active" : "") @(State.Minimized ? "is-min" : "") @(State.Maximized ? "is-max" : "")"
         style="left:@Fmt.Px(State.X);top:@Fmt.Px(State.Y);width:@Fmt.Px(State.Width);height:@Fmt.Px(State.Height);z-index:@State.Z"
         data-win="@State.Id" role="dialog" aria-label="@State.App.Title"
         @onpointerdown="() => Desk.Windows.Focus(State.Id)">
    <header class="win-bar" @ondblclick="() => Desk.Windows.ToggleMaximize(State.Id)">
        <span class="win-icon"><AppIcon Name="@State.Id" Size="18" /></span>
        <h2 class="win-title">@State.App.Title</h2>
        <div class="win-controls" @ondblclick:stopPropagation="true">
            <button type="button" class="win-btn" aria-label="Minimize @State.App.Title" @onclick="() => Desk.Windows.Minimize(State.Id)">
                <AppIcon Name="minimize" Size="14" />
            </button>
            <button type="button" class="win-btn win-btn-max" aria-label="@(State.Maximized ? "Restore" : "Maximize") @State.App.Title"
                    @onclick="() => Desk.Windows.ToggleMaximize(State.Id)">
                <AppIcon Name="@(State.Maximized ? "restore" : "maximize")" Size="14" />
            </button>
            <button type="button" class="win-btn win-btn-close" aria-label="Close @State.App.Title" @onclick="() => Desk.Windows.Close(State.Id)">
                <AppIcon Name="close" Size="14" />
            </button>
        </div>
    </header>
    <div class="win-body">
        <DynamicComponent Type="AppRegistry.For(State.Id)" />
    </div>
    <div class="win-grip" aria-hidden="true"></div>
</section>

@code {
    [Parameter, EditorRequired] public WindowState State { get; set; } = default!;

    private bool IsActive => Desk.Windows.Active == State;
}
