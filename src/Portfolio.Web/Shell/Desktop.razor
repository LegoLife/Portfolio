@implements IDisposable
@inject DesktopService Desk

@if (!Desk.Ready)
{
    return;
}

<div class="desktop" @onclick="() => _launcher = false" @onkeydown="OnKey">
    <div class="wallpaper" aria-hidden="true">
        <p class="wall-kicker">@Profile.Role</p>
        <p class="wall-name"><span>Jake</span><span class="wall-outline">Steffen</span></p>
        <p class="wall-hint">Open an icon. Drag a window. Nothing here can break.</p>
    </div>

    @if (Desk.Stickers)
    {
        <div class="stickers" aria-hidden="true">
            @for (var i = 0; i < Stickers.Length; i++)
            {
                <span class="sticker sticker-@(i + 1) accent-@Stickers[i].Accent">@Stickers[i].Text</span>
            }
        </div>
    }

    <nav class="icons" aria-label="Apps">
        @foreach (var app in AppCatalog.All)
        {
            <button type="button" class="icon" title="@app.Blurb" @onclick="() => Desk.Open(app.Id)">
                <span class="icon-tile accent-@app.Accent"><AppIcon Name="@app.Id" Size="28" /></span>
                <span class="icon-label">@app.Title</span>
            </button>
        }
    </nav>

    <main class="windows">
        <h1 class="sr-only">@Profile.Name, @Profile.Role</h1>
        @foreach (var window in Desk.Windows.Windows)
        {
            <Window @key="window.Id" State="window" />
        }
    </main>

    @if (_launcher)
    {
        <div class="launcher" role="menu" aria-label="All apps" @onclick:stopPropagation="true">
            <div class="launcher-head">
                <img src="images/me.jpg" alt="" width="44" height="44" />
                <div>
                    <strong>@Profile.Name</strong>
                    <span>@Profile.Role</span>
                </div>
            </div>
            @foreach (var group in AppCatalog.All.GroupBy(a => a.Group))
            {
                <p class="launcher-group">@group.Key</p>
                @foreach (var app in group)
                {
                    <button type="button" role="menuitem" class="launcher-item" @onclick="() => Launch(app.Id)">
                        <span class="icon-tile small accent-@app.Accent"><AppIcon Name="@app.Id" Size="18" /></span>
                        <span class="launcher-text"><strong>@app.Title</strong><span>@app.Blurb</span></span>
                    </button>
                }
            }
        </div>
    }

    <footer class="taskbar" @onclick:stopPropagation="true">
        <button type="button" class="start @(_launcher ? "is-open" : "")" aria-haspopup="menu" aria-expanded="@(_launcher ? "true" : "false")"
                @onclick="() => _launcher = !_launcher">
            <span class="start-mark">J</span><span class="start-text">jakeOS</span>
        </button>

        <div class="tasks" role="list" aria-label="Open windows">
            @foreach (var window in Desk.Windows.Windows)
            {
                <button type="button" role="listitem" title="@window.App.Title"
                        class="task accent-@window.App.Accent @(Desk.Windows.Active == window ? "is-active" : "") @(window.Minimized ? "is-min" : "")"
                        @onclick="() => Desk.Windows.Toggle(window.Id)">
                    <AppIcon Name="@window.Id" Size="16" /><span class="task-text">@window.App.Title</span>
                </button>
            }
        </div>

        <button type="button" class="tray-btn hello" @onclick="@(() => Launch("contact"))">Say hello</button>
        <button type="button" class="tray-btn" title="Switch theme (now: @Desk.Theme)" aria-label="Switch theme" @onclick="Desk.NextThemeAsync">
            <AppIcon Name="theme" Size="18" />
        </button>
        <Clock />
    </footer>
</div>

@code {
    private static readonly (string Text, string Accent)[] Stickers =
    [
        ("C#", "purple"), (".NET", "blue"), ("SQL Server", "red"), ("Angular", "orange"), ("Blazor", "green"), ("Azure DevOps", "yellow"),
    ];

    private bool _launcher;

    protected override async Task OnInitializedAsync()
    {
        var startApp = await Desk.InitAsync();
        Desk.Changed += Refresh;
        // A link such as /#resume opens straight to that app; otherwise say hello.
        Desk.Open(AppCatalog.Find(startApp)?.Id ?? "about");
    }

    private void Launch(string appId)
    {
        _launcher = false;
        Desk.Open(appId);
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _launcher = false;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Desk.Changed -= Refresh;
}
