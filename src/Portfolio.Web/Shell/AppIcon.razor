@* Line icons drawn on a 24 by 24 grid. Name is an app id or a glyph name. *@
<svg class="glyph" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "about":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" />
            break;
        case "resume":
            <path d="M6 3h8l4 4v14H6z" />
            <path d="M14 3v4h4M9 12h6M9 16h6" />
            break;
        case "projects":
            <path d="M3 6h6l2 2h10v11H3z" />
            break;
        case "contact":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
            break;
        case "terminal":
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="m7 9 3 3-3 3M12 15h5" />
            break;
        case "brickforge":
            <rect x="3" y="9" width="18" height="11" rx="1" />
            <path d="M6 9V5h4v4M14 9V5h4v4" />
            break;
        case "listings":
            <path d="m3 11 9-8 9 8" />
            <path d="M5 10v10h14V10M10 20v-6h4v6" />
            break;
        case "dashboard":
            <path d="M3 20h18M6 20v-9M12 20V4M18 20v-6" />
            break;
        case "datagen":
            <path d="M8 4c-2 0-3 1-3 3v2c0 1.5-1 2.5-2 3 1 .5 2 1.500 2 3v2c0 2 1 3 3 3" />
            <path d="M16 4c2 0 3 1 3 3v2c0 1.500 1 2.500 2 3-1 .5-2 1.500-2 3v2c0 2-1 3-3 3" />
            break;
        case "invest":
            <path d="m3 17 6-6 4 4 8-8" />
            <path d="M15 7h6v6" />
            break;
        case "settings":
            <path d="M4 6h8M18 6h2M4 12h2M12 12h8M4 18h10M20 18h0" />
            <circle cx="15" cy="6" r="2" />
            <circle cx="9" cy="12" r="2" />
            <circle cx="17" cy="18" r="2" />
            break;
        case "minimize":
            <path d="M6 18h12" />
            break;
        case "maximize":
            <rect x="5" y="5" width="14" height="14" rx="1" />
            break;
        case "restore":
            <rect x="5" y="9" width="10" height="10" rx="1" />
            <path d="M9 9V5h10v10h-4" />
            break;
        case "close":
            <path d="m6 6 12 12M18 6 6 18" />
            break;
        case "external":
            <path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" />
            break;
        case "theme":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2" />
            break;
        default:
            <rect x="4" y="4" width="16" height="16" rx="3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
}
