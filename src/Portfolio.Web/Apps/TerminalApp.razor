@inject DesktopService Desk

<div class="terminal" @onclick="FocusInput">
    <div class="term-out" id="term-out" aria-live="polite">
        @foreach (var line in _lines)
        {
            <div class="term-line term-@line.Kind.ToString().ToLowerInvariant()">@line.Text</div>
        }
    </div>
    <label class="term-in">
        <span class="term-prompt">@TerminalShell.Prompt</span>
        <input @ref="_input" id="term-input" value="@_text" @oninput="e => _text = e.Value?.ToString() ?? string.Empty" @onkeydown="OnKey"
               aria-label="Terminal command" autocomplete="off" autocapitalize="off" spellcheck="false" />
    </label>
</div>

@code {
    private readonly TerminalShell _shell = new();
    private readonly List<TermLine> _lines = [.. TerminalShell.Banner];
    private readonly List<string> _history = [];
    private int _historyIndex;
    private string _text = "";
    private ElementReference _input;
    private bool _scroll;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Desk.TerminalKeysAsync("#term-input");
            await FocusInput();
        }
        if (_scroll)
        {
            _scroll = false;
            await Desk.ScrollToEndAsync("#term-out");
        }
    }

    private async Task FocusInput()
    {
        try { await _input.FocusAsync(); } catch (JSException) { /* window is minimised */ }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await Run(_text);
                break;
            case "Tab":
                _text = TerminalShell.Complete(_text);
                break;
            case "ArrowUp" when _history.Count > 0:
                _historyIndex = Math.Max(0, _historyIndex - 1);
                _text = _history[_historyIndex];
                break;
            case "ArrowDown" when _history.Count > 0:
                _historyIndex = Math.Min(_history.Count, _historyIndex + 1);
                _text = _historyIndex < _history.Count ? _history[_historyIndex] : "";
                break;
        }
    }

    private async Task Run(string command)
    {
        _text = "";
        _scroll = true;
        _lines.Add(new($"{TerminalShell.Prompt} {command}", LineKind.Input));
        if (command.Trim().Length > 0)
        {
            _history.Add(command.Trim());
            _historyIndex = _history.Count;
        }

        var result = _shell.Execute(command);
        if (result.Clear) _lines.Clear();
        _lines.AddRange(result.Lines);

        if (result.Theme is not null) await Desk.SetThemeAsync(result.Theme);
        if (result.OpenApp is not null) Desk.Open(result.OpenApp);
        if (result.Exit) Desk.Windows.Close("terminal");
    }
}
