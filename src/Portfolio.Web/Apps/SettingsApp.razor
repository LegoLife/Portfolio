@implements IDisposable
@inject DesktopService Desk

<div class="app settings">
    <h3 class="section-title">Theme</h3>
    <div class="theme-list" role="radiogroup" aria-label="Theme">
        @foreach (var (id, name) in Themes)
        {
            <button type="button" role="radio" aria-checked="@(Desk.Theme == id ? "true" : "false")"
                    class="theme-option theme-@id @(Desk.Theme == id ? "is-on" : "")" @onclick="() => Desk.SetThemeAsync(id)">
                <span class="theme-swatch"><i></i></span>
                @name
            </button>
        }
    </div>

    <h3 class="section-title">Desktop</h3>
    <label class="check">
        <input type="checkbox" checked="@Desk.Stickers" @onchange="e => Desk.SetStickersAsync(e.Value is true)" />
        Show the skill stickers (you can drag them around)
    </label>
    <div class="actions">
        <button type="button" class="btn small" @onclick="Desk.Windows.CloseAll">Close every window</button>
    </div>

    <h3 class="section-title">About jakeOS</h3>
    <p class="muted">
        Built by Jake Steffen with Blazor WebAssembly and .NET 10. No UI framework and no chart library: the windows, grids and charts are hand-written.
        <a href="https://github.com/LegoLife/Portfolio" target="_blank" rel="noopener">Read the source</a>.
    </p>
</div>

@code {
    private static readonly (string Id, string Name)[] Themes = [("day", "Day"), ("night", "Night"), ("blueprint", "Blueprint")];

    protected override void OnInitialized() => Desk.Changed += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Desk.Changed -= Refresh;
}
