@* BrickForge is its own published site, so it runs here in a frame. *@

<div class="embed-bar">
    <span>Running live from legolife.github.io/BrickForge. The keyboard and mouse controls are listed along its top edge.</span>
    <a class="btn small" href="@Url" target="_blank" rel="noopener">Open full screen</a>
</div>
<iframe class="embed-frame" src="@Url" title="BrickForge, a 3D brick builder" loading="lazy" allow="fullscreen"></iframe>

@code {
    private const string Url = "https://legolife.github.io/BrickForge/";
}
